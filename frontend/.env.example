# VaultWise — frontend environment variables
#
# Copy this file to `.env.local` and fill in your deployed addresses:
#
#     cd frontend && cp .env.example .env.local
#
# `.env.local` is git-ignored, so your addresses never get committed.
# If a variable is not set, the app shows a warning banner for that experiment
# and leaves its buttons disabled rather than pointing at a wrong contract.
#
# Restart `npm run dev` after editing — Vite only reads env files at startup.
#
# NEVER put a private key or seed phrase in this file (or anywhere in this
# project). Vite inlines every VITE_* variable into the public bundle.
# Deployment keys belong in Hardhat's encrypted keystore instead:
#
#     npx hardhat keystore set SEPOLIA_PRIVATE_KEY

# ── Experiment 1 — plain ETH vault ────────────────────────────────────────
# contracts/experiment1/VaultWiseVault.sol
VITE_CONTRACT_ADDRESS=DEPLOYED_ETH_VAULT_ADDRESS

# ── Experiment 3 — ERC-20 asset + ERC-4626 vault ──────────────────────────
# contracts/experiment3/MockUSDC.sol
VITE_USDC_ADDRESS=DEPLOYED_MOCK_USDC_ADDRESS

# contracts/experiment3/VaultWiseVault.sol
VITE_VAULT4626_ADDRESS=DEPLOYED_ERC4626_VAULT_ADDRESS

# ── Experiment 4 — AMM liquidity pool ─────────────────────────────────────
# contracts/experiment4/MockERC20.sol, deployed with ("Token A", "TKA")
VITE_TOKEN_A_ADDRESS=DEPLOYED_TOKEN_A_ADDRESS

# contracts/experiment4/MockERC20.sol, deployed again with ("Token B", "TKB")
VITE_TOKEN_B_ADDRESS=DEPLOYED_TOKEN_B_ADDRESS

# contracts/experiment4/SimpleAMM.sol, deployed with (TKA address, TKB address)
VITE_AMM_ADDRESS=DEPLOYED_SIMPLE_AMM_ADDRESS

# Optional: the block SimpleAMM was deployed in. The pool-activity history
# reads event logs from here; if unset, it reads the most recent 50 000 blocks.
VITE_AMM_DEPLOY_BLOCK=

# ── Experiment 5 — yield farming (Part 1) + protocol staking (Part 2) ─────
# `npm run deploy:exp5:sepolia` (repository root) prints all six lines.
# MockERC20 is contracts/experiment4/MockERC20.sol, reused unchanged.

# Part 1: MockERC20 deployed with ("LP Token", "LPT")
VITE_LPT_ADDRESS=DEPLOYED_LPT_ADDRESS

# Part 1: MockERC20 deployed with ("Reward Token", "RWD") — the farm's reward token
VITE_FARM_RWD_ADDRESS=DEPLOYED_FARM_RWD_ADDRESS

# Part 1: contracts/experiment5/SimpleYieldFarm.sol, deployed with (LPT, farm RWD)
VITE_YIELD_FARM_ADDRESS=DEPLOYED_SIMPLE_YIELD_FARM_ADDRESS

# Part 2: MockERC20 deployed with ("Protocol Token", "ABC")
VITE_ABC_ADDRESS=DEPLOYED_ABC_ADDRESS

# Part 2: MockERC20 deployed with ("Reward Token", "RWD") — staking's own reward token
VITE_STAKING_RWD_ADDRESS=DEPLOYED_STAKING_RWD_ADDRESS

# Part 2: contracts/experiment5/SimpleStaking.sol, deployed with (ABC, staking RWD)
VITE_STAKING_ADDRESS=DEPLOYED_SIMPLE_STAKING_ADDRESS

# ── Experiment 6 — DEX prototype (Factory + Pair + Router) ─────────────────
# `npm run deploy:exp6:sepolia` (repository root) prints all five lines.
# Pairs are NOT listed here: the Factory creates them and the app finds them
# with getPair(). LPFarm (optional) is not used by the UI.

# contracts/experiment6/Factory.sol
VITE_DEX_FACTORY_ADDRESS=DEPLOYED_DEX_FACTORY_ADDRESS

# contracts/experiment6/Router.sol, deployed with (Factory address)
VITE_DEX_ROUTER_ADDRESS=DEPLOYED_DEX_ROUTER_ADDRESS

# contracts/experiment6/DexMockERC20.sol, deployed with ("Token A","DXA"), ("Token B","DXB"), ("Token C","DXC")
VITE_DEX_TOKEN_A_ADDRESS=DEPLOYED_DEX_TOKEN_A_ADDRESS
VITE_DEX_TOKEN_B_ADDRESS=DEPLOYED_DEX_TOKEN_B_ADDRESS
VITE_DEX_TOKEN_C_ADDRESS=DEPLOYED_DEX_TOKEN_C_ADDRESS
