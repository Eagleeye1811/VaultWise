# VaultWise — frontend environment variables
#
# The values below point at the public VaultWise deployment on Sepolia
# (chain ID 11155111). Copy this file and the app works out of the box:
#
#     cd frontend && cp .env.example .env.local
#
# Change an address only if you deploy your own contracts — each deploy
# script prints the exact lines to paste here. `.env.local` is git-ignored.
#
# If a product's addresses are missing, the app shows a warning for it and
# leaves its actions disabled rather than pointing at a wrong contract.
#
# Restart `npm run dev` after editing — Vite only reads env files at startup.
#
# NEVER put a private key or seed phrase in this file (or anywhere in this
# project). Vite inlines every VITE_* variable into the public bundle.
# Deployment keys belong in Hardhat's encrypted keystore instead:
#
#     npx hardhat keystore set SEPOLIA_PRIVATE_KEY

# ── Read RPC (optional) ───────────────────────────────────────────────────
# Public Sepolia endpoint used for reads when no wallet is connected, so the
# markets render for every visitor. Defaults to publicnode.com if unset.
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── ETH vault ─────────────────────────────────────────────────────────────
# contracts/experiment1/VaultWiseVault.sol
VITE_CONTRACT_ADDRESS=0x172b07bab2415A7EF32eA150c499CFB9B6cc236a

# ── ERC-4626 vault ────────────────────────────────────────────────────────
# contracts/experiment3/MockUSDC.sol — the vault's underlying asset
VITE_USDC_ADDRESS=0x85016FBbE60423B5aB92B6b9d9646FCAA51628e5

# contracts/experiment3/VaultWiseVault.sol, deployed with (MockUSDC address)
VITE_VAULT4626_ADDRESS=0x4fc3c56482DC1a4c9411A7C5890702284Af6e070

# ── AMM pool ──────────────────────────────────────────────────────────────
# contracts/experiment4/MockERC20.sol, deployed with ("Token A", "TKA")
VITE_TOKEN_A_ADDRESS=0x785BD01f7EA2BFD11f7Dfa3e53129b83Ab807138

# contracts/experiment4/MockERC20.sol, deployed again with ("Token B", "TKB")
VITE_TOKEN_B_ADDRESS=0xfD6f659d80e0E7aF1bbddA58c33c73C855C2114b

# contracts/experiment4/SimpleAMM.sol, deployed with (TKA address, TKB address)
VITE_AMM_ADDRESS=0x14bDB27779bC6A8DA677e7674B09105AeFEb6ceb

# Optional: the block SimpleAMM was deployed in. The pool-activity history
# reads event logs from here; if unset, it reads the most recent 50 000 blocks.
VITE_AMM_DEPLOY_BLOCK=11915032

# ── Yield farm ────────────────────────────────────────────────────────────
# MockERC20 is contracts/experiment4/MockERC20.sol.

# MockERC20 deployed with ("LP Token", "LPT") — the token staked in the farm
VITE_LPT_ADDRESS=0xEd305BEcD7fFc199Da9883E2a8d56f71fE01aDA6

# MockERC20 deployed with ("Reward Token", "RWD") — the farm's reward token
VITE_FARM_RWD_ADDRESS=0x46FD1d37F0dd37E03443A6Bc8B36d34e78304443

# contracts/experiment5/SimpleYieldFarm.sol, deployed with (LPT, farm RWD)
VITE_YIELD_FARM_ADDRESS=0xcE26f526B5Dd6F0b2DEE9eE8575B224967b22B30

# ── Staking ───────────────────────────────────────────────────────────────
# MockERC20 deployed with ("Protocol Token", "ABC")
VITE_ABC_ADDRESS=0x36ee3668B13Efe258C1AC229C0A043c806B99683

# MockERC20 deployed with ("Reward Token", "RWD") — staking's own reward token
VITE_STAKING_RWD_ADDRESS=0xd47c4EA94928546815919a2B1D67F363A4BF3182

# contracts/experiment5/SimpleStaking.sol, deployed with (ABC, staking RWD)
VITE_STAKING_ADDRESS=0x7e2aB3fd700a00bcF9E8CD8285b0934580454359

# ── DEX (Factory + Pair + Router) ─────────────────────────────────────────
# Pairs are NOT listed here: the Factory creates them and the app finds them
# with getPair(). LPFarm (optional) is not used by the UI.

# contracts/experiment6/Factory.sol
VITE_DEX_FACTORY_ADDRESS=0x5b61081462e34e008B4D863Dd65506dd7863cC08

# contracts/experiment6/Router.sol, deployed with (Factory address)
VITE_DEX_ROUTER_ADDRESS=0x24024e2590c0d1c41fb0b7b960e6a8Ca43B32658

# contracts/experiment6/DexMockERC20.sol, deployed with ("Token A","DXA"), ("Token B","DXB"), ("Token C","DXC")
VITE_DEX_TOKEN_A_ADDRESS=0xEE5090e062015fADBE15d9dBE213c10112AC701e
VITE_DEX_TOKEN_B_ADDRESS=0x19CBfe5efEfa8Ab20A0AD5FA9F0CA7E9b6E85633
VITE_DEX_TOKEN_C_ADDRESS=0xa30B7353F1869B20ED7eCF05586C1F35722952B9
