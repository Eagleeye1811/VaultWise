# VaultWise — frontend environment variables
#
# Copy this file to `.env.local` and fill in your deployed contract address:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored, so your local address never gets committed.
# If this variable is not set, the fallback in
# `src/contracts/contractConfig.js` is used instead.
#
# NEVER put a private key or seed phrase in this file (or anywhere in this
# project). Vite inlines every VITE_* variable into the public bundle.

VITE_CONTRACT_ADDRESS=DEPLOYED_CONTRACT_ADDRESS
