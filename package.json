{
  "name": "vaultwise-contracts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VaultWise smart contracts — Hardhat workspace for compiling, testing and deploying the Experiment 1 ETH vault, the Experiment 3 ERC-4626 vault, the Experiment 4 AMM liquidity pool the Experiment 5 yield farm and staking contracts, the Experiment 6 DEX prototype and the Chainlink-backed PriceOracle.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "sync-abi": "node scripts/syncAbi.js",
    "demo": "hardhat run scripts/experiment3Lifecycle.js",
    "deploy:sepolia": "hardhat run scripts/deployExperiment3.js --network sepolia",
    "demo:exp4": "hardhat run scripts/experiment4Lifecycle.js",
    "deploy:exp4:sepolia": "hardhat run scripts/deployExperiment4.js --network sepolia",
    "verify:exp4": "node scripts/verifyExperiment4.js",
    "verify:sepolia": "node scripts/verifyDeployment.js",
    "test:exp5": "hardhat test test/experiment5.test.js test/experiment5.frontend.test.js test/experiment5.resume.test.js",
    "demo:exp5": "hardhat run scripts/experiment5Lifecycle.js",
    "deploy:exp5": "hardhat run scripts/deployExperiment5.js",
    "deploy:exp5:sepolia": "hardhat run scripts/deployExperiment5.js --network sepolia",
    "verify:exp5": "node scripts/checkExperiment5.js",
    "resume:exp5:sepolia": "hardhat run scripts/resumeExperiment5.js --network sepolia",
    "test:exp6": "hardhat test test/experiment6.test.js test/experiment6.frontend.test.js",
    "demo:exp6": "hardhat run scripts/experiment6Lifecycle.js",
    "deploy:exp6": "hardhat run scripts/deployExperiment6.js",
    "deploy:exp6:sepolia": "hardhat run scripts/deployExperiment6.js --network sepolia",
    "test:oracle": "hardhat test test/oracle.test.js test/oracle.frontend.test.js",
    "deploy:oracle": "hardhat run scripts/deployOracle.js",
    "deploy:oracle:sepolia": "hardhat run scripts/deployOracle.js --network sepolia",
    "verify:oracle": "node scripts/checkOracle.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.16.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
